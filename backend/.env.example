# Copy this file to .env and fill in real values before running in production.
# In development, sensible defaults are used automatically if .env is missing.

# Port the API server listens on
PORT=4000

# Origin allowed to make credentialed requests (your frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens — use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production

# Token lifetime, in seconds (default 7 days)
JWT_EXPIRES_IN=604800

# Set to "true" when serving the API over HTTPS in production
# (marks the auth cookie as Secure so browsers only send it over TLS)
COOKIE_SECURE=false

# Resend (https://resend.com) is used to send "forgot password" emails.
# Get a free API key from https://resend.com/api-keys — no domain
# verification needed to send from the shared onboarding@resend.dev
# address below. Leave RESEND_API_KEY blank to fall back to logging
# the reset link to the console instead (useful for local dev).
RESEND_API_KEY=
RESEND_FROM=StudySphere <onboarding@resend.dev>
