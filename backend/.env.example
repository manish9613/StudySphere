# Copy this file to .env and fill in real values before running in production.
# In development, sensible defaults are used automatically if .env is missing.

# Port the API server listens on
PORT=4000

# Origin allowed to make credentialed requests (your frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens — use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production

# Token lifetime, in seconds (default 7 days)
JWT_EXPIRES_IN=604800

# Set to "true" when serving the API over HTTPS in production
# (marks the auth cookie as Secure so browsers only send it over TLS)
COOKIE_SECURE=false
